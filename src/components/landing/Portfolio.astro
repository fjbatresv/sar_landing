---
import { AUTHOR_EMAIL, AUTHOR_URL, type Lang } from '../../data/landing';
import ServiceDay from './ServiceDay.astro';
const { lang, data } = Astro.props as { lang: Lang; data: any };
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<a class="skip" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
<header class="wrap nav"><a class="wordmark" href={base}>SAR<span> / operations</span></a><nav aria-label="Primary"><a href="#day">{data.nav[0]}</a><a href="#architecture">{data.nav[1]}</a><a href="#decisions">{data.nav[2]}</a><a href={`${base}docs/`}>{data.nav[3]}</a><a href={lang === 'es' ? base : `${base}es/`} lang={lang === 'es' ? 'en' : 'es'}>{lang === 'es' ? 'EN' : 'ES'}</a></nav><a class="button small" href={`mailto:${AUTHOR_EMAIL}`}>{data.cta}</a></header>
<main id="main">
<section class="hero wrap"><div><p class="eyebrow">{lang === 'es' ? 'Caso de estudio · Plataforma de operaciones' : 'Case study · Operations platform'}</p><h1>{data.hero[0]}<br />{data.hero[1]}</h1><p class="lead">{data.intro}</p><p class="actions"><a class="button" href={`mailto:${AUTHOR_EMAIL}`}>{data.cta}</a><a class="text-link" href="#architecture">{lang === 'es' ? 'Ver la arquitectura' : 'Explore the architecture'}</a></p></div><div class="hero-note"><span class="open-dot"></span><strong>{lang === 'es' ? 'Sistema en operación' : 'Operations in motion'}</strong><p>06:00 — 24:00</p><span class="note-rule"></span><span>{lang === 'es' ? 'Conteo · Venta · Compra · Cierre' : 'Count · Sell · Receive · Close'}</span></div></section>
<ServiceDay title={data.day} events={data.events} />
<section class="wrap section split" id="problem"><div><p class="eyebrow">{lang === 'es' ? 'Lo que había que resolver' : 'The operating brief'}</p><h2>{lang === 'es' ? 'Cada jornada exige decisiones rápidas y datos confiables.' : 'Every shift depends on quick decisions and reliable data.'}</h2></div><p class="body-copy">{data.problem}</p></section>
<section class="architecture section" id="architecture"><div class="wrap"><p class="eyebrow">{lang === 'es' ? 'Cómo se conecta' : 'How it connects'}</p><h2>{lang === 'es' ? 'Tres formas de construir un solo sistema.' : 'Three ways of building one system.'}</h2><p class="body-copy">{data.architecture}</p><figure class="diagram"><svg viewBox="0 0 1000 240" role="img" aria-labelledby="diagram-title diagram-desc"><title id="diagram-title">{lang === 'es' ? 'Vista de arquitectura' : 'Architecture overview'}</title><desc id="diagram-desc">Angular frontend reaches domain services and event driven functions on AWS, provisioned by Terraform.</desc><path d="M180 120H355M595 120H665M865 120H920" stroke="currentColor" stroke-width="3" stroke-dasharray="7 8"/><g class="node"><rect x="20" y="58" width="160" height="124" rx="4"/><text x="100" y="110">Angular 19</text><text x="100" y="140">Nx frontend</text></g><g class="node"><rect x="355" y="58" width="240" height="124" rx="4"/><text x="475" y="110">Java · Spring Boot</text><text x="475" y="140">ECS Fargate</text></g><g class="node node-event"><rect x="665" y="58" width="200" height="124" rx="4"/><text x="765" y="110">Lambda</text><text x="765" y="140">Events · Queues</text></g><text class="infra" x="500" y="220">AWS · Terraform · API Gateway · CloudFront</text></svg><figcaption>{lang === 'es' ? 'Diagrama simplificado de los límites principales del sistema.' : 'Simplified view of the system’s main boundaries.'}</figcaption></figure></div></section>
<section class="wrap section" id="stack"><p class="eyebrow">{lang === 'es' ? 'Plataforma' : 'Platform'}</p><h2>{lang === 'es' ? 'Cada herramienta tiene su lugar.' : 'Each tool has a job.'}</h2><dl class="stack">{data.stack.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section>
<section class="section decisions" id="decisions"><div class="wrap"><p class="eyebrow">{lang === 'es' ? 'Decisiones y trade-offs' : 'Decisions and trade-offs'}</p><h2>{lang === 'es' ? 'Las decisiones técnicas también tienen costo.' : 'Every technical choice has a cost.'}</h2><dl>{data.decisions.map(([title, body]) => <div><dt>{title}</dt><dd>{body}</dd></div>)}</dl></div></section>
<section class="wrap section role"><div><p class="eyebrow">{lang === 'es' ? 'Mi contribución' : 'My contribution'}</p><h2>{lang === 'es' ? 'Construido en equipo.' : 'Built as a team.'}</h2></div><p class="body-copy">{data.role}</p></section>
<section class="wrap section product"><div class="gallery-heading"><p class="eyebrow">{lang === 'es' ? 'Vistas del producto' : 'Product views'}</p><h2>{data.gallery}</h2><p class="body-copy">{lang === 'es' ? 'Capturas realizadas con una sesión y respuestas ficticias.' : 'Captured with a fictional session and mocked API responses.'}</p></div><div class="gallery-grid">{data.screens.map(([label, key]) => <figure><img src={`${base}assets/screens/${key}-desktop.webp`} width="1440" height="900" loading="lazy" alt={`${lang === 'es' ? 'Captura ficticia de' : 'Fictional'} ${label}`} /><figcaption>{label}</figcaption></figure>)}</div></section>
<section class="contact"><div class="wrap contact-inner"><p class="eyebrow">{lang === 'es' ? 'Contacto' : 'Contact'}</p><h2>{data.contact}</h2><a class="button" href={`mailto:${AUTHOR_EMAIL}`}>{data.email}</a><a class="text-link" href={AUTHOR_URL}>{AUTHOR_URL.replace('https://', '')}</a><p><a href={`${base}docs/`}>{data.docs}</a></p></div></section></main>
<footer class="wrap footer"><p>{data.footer}</p><a href={AUTHOR_URL}>fjbatresv.com</a></footer>
