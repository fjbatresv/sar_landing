---
import { AUTHOR_EMAIL, AUTHOR_URL, type Lang, type LandingCopy } from '../../data/landing';
import ArchitectureDiagram from './ArchitectureDiagram.astro';
import ServiceDay from './ServiceDay.astro';

const { lang, data } = Astro.props as { lang: Lang; data: LandingCopy };
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const navIds = ['day', 'product', 'architecture', 'flows', 'work', 'docs'];
const icons = ['inventory_2', 'payments', 'event_available', 'admin_panel_settings'];
const requestIcons = ['person', 'key', 'verified_user', 'router', 'task_alt'];
---

<a class="skip" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>

<header class="site-header">
  <a class="wordmark" href={base} aria-label="SAR operations home"><span class="brand-mark" aria-hidden="true">S</span><span>SAR <small>{lang === 'es' ? 'operaciones' : 'operations'}</small></span></a>
  <nav aria-label={lang === 'es' ? 'Principal' : 'Primary'}>
    {data.nav.map((item, index) => <a href={index === 5 ? `${base}docs/` : `#${navIds[index]}`}>{item}</a>)}
  </nav>
  <a class="button button-small" href={`mailto:${AUTHOR_EMAIL}`}>{lang === 'es' ? 'Hablemos' : 'Let’s talk'}</a>
  <a class="language-link" href={lang === 'es' ? base : `${base}es/`} lang={lang === 'es' ? 'en' : 'es'}>{lang === 'es' ? 'English' : 'Español'}</a>
  <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label={lang === 'es' ? 'Cambiar tema' : 'Change theme'} data-light-label={lang === 'es' ? 'Modo oscuro' : 'Dark mode'} data-dark-label={lang === 'es' ? 'Modo claro' : 'Light mode'}><span class="material-symbols-outlined" aria-hidden="true">dark_mode</span><span data-theme-label>{lang === 'es' ? 'Modo oscuro' : 'Dark mode'}</span></button>
</header>

<main id="main">
  <section class="hero">
    <div class="hero-inner wrap">
      <div class="hero-copy">
        <p class="hero-kicker"><span class="material-symbols-outlined" aria-hidden="true">storefront</span>{lang === 'es' ? 'Caso de estudio de plataforma operativa' : 'Operations platform case study'}</p>
        <h1>{data.hero[0]}<br /><span>{data.hero[1]}</span></h1>
        <p class="hero-lead">{data.intro}</p>
        <div class="hero-actions">
          <a class="button" href={`mailto:${AUTHOR_EMAIL}`}>{lang === 'es' ? 'Hablemos de tu proyecto' : 'Talk about your project'}</a>
          <a class="hero-secondary" href="#architecture">{lang === 'es' ? 'Explorar arquitectura' : 'Explore the architecture'} <span aria-hidden="true">↘</span></a>
        </div>
      </div>
      <aside class="hero-note">
        <div class="hero-note-top"><span class="material-symbols-outlined" aria-hidden="true">schedule</span><span>{lang === 'es' ? 'Una jornada, conectada' : 'One connected service day'}</span></div>
        <div class="hero-clock"><span>06:00</span><span class="clock-line"></span><span>24:00</span></div>
        <p>{data.heroNote}</p>
      </aside>
    </div>
  </section>

  <ServiceDay lang={lang} title={data.dayTitle} intro={data.dayIntro} moments={data.moments} />

  <section class="product-section section-pad" id="product">
    <div class="wrap">
      <div class="section-heading section-heading-wide">
        <p class="section-context">{lang === 'es' ? 'Operación diaria' : 'Daily operations'}</p>
        <h2>{data.productTitle}</h2>
        <p>{data.productIntro}</p>
      </div>
      <div class="family-grid">
        {data.families.map((family, index) => (
          <article class={`family family-${index + 1}`}>
            <div class="family-icon"><span class="material-symbols-outlined" aria-hidden="true">{icons[index]}</span></div>
            <div class="family-copy"><h3>{family.title}</h3><p>{family.summary}</p></div>
            <ul>{family.capabilities.map((capability) => <li>{capability}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="metrics-band" aria-label={lang === 'es' ? 'Cifras del proyecto' : 'Project scale'}>
    <div class="wrap metrics-grid">
      {data.metrics.map((metric) => <div class="metric"><strong>{metric.value}</strong><span>{metric.label}</span></div>)}
    </div>
  </section>

  <section class="architecture-section section-pad" id="architecture">
    <div class="wrap">
      <div class="section-heading section-heading-wide">
        <p class="section-context">{lang === 'es' ? 'Límites y comunicaciones' : 'Boundaries and communication'}</p>
        <h2>{data.architectureTitle}</h2>
        <p>{data.architectureIntro}</p>
      </div>
      <ArchitectureDiagram lang={lang} data={data} />
      <div class="architecture-notes">
        <div class="architecture-list-block">
          <h3>{data.diagramListTitle}</h3>
          <ul>{data.diagramList.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="request-block">
          <h3>{data.requestTitle}</h3>
          <ol class="request-steps">
            {data.requestSteps.map((step, index) => <li><span class="request-number">0{index + 1}</span><span class="material-symbols-outlined" aria-hidden="true">{requestIcons[index]}</span><span>{step}</span></li>)}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="flows-section section-pad" id="flows">
    <div class="wrap">
      <div class="section-heading">
        <p class="section-context">{lang === 'es' ? 'De la operación al resultado' : 'From operation to outcome'}</p>
        <h2>{data.flowsTitle}</h2>
      </div>
      <div class="flow-list">
        {data.flows.map((flow, flowIndex) => (
          <article class="flow-card">
            <div class="flow-heading"><span class="flow-index">0{flowIndex + 1}</span><div><h3>{flow.title}</h3><p>{flow.intro}</p></div></div>
            <ol class="flow-steps">{flow.steps.map((step, index) => <li><span class="flow-step-index">{index + 1}</span><div><strong>{step.title}</strong><p>{step.detail}</p></div></li>)}</ol>
            <a class="inline-link" href="#screen-dashboard">{lang === 'es' ? 'Ver el panel operativo' : 'View the operations dashboard'} <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="decisions-section section-pad" id="decisions">
    <div class="wrap">
      <div class="section-heading section-heading-wide">
        <p class="section-context">{lang === 'es' ? 'Arquitectura con consecuencias' : 'Architecture with consequences'}</p>
        <h2>{data.decisionsTitle}</h2>
        <p>{data.decisionsIntro}</p>
      </div>
      <div class="decision-table">
        <div class="decision-header"><span>{lang === 'es' ? 'Contexto' : 'Context'}</span><span>{lang === 'es' ? 'Decisión' : 'Decision'}</span><span>Trade-off</span></div>
        {data.decisions.map((decision) => <article class="decision-row"><h3>{decision.title}</h3><p>{decision.context}</p><p>{decision.choice}</p><p>{decision.tradeoff}</p></article>)}
      </div>
    </div>
  </section>

  <section class="quality-section section-pad">
    <div class="wrap quality-layout">
      <div class="section-heading">
        <p class="section-context">{lang === 'es' ? 'Cómo se entrega' : 'How it ships'}</p>
        <h2>{data.qualityTitle}</h2>
        <p>{data.qualityIntro}</p>
      </div>
      <div class="quality-list">{data.qualityItems.map((item) => <article><span class="material-symbols-outlined" aria-hidden="true">task_alt</span><div><h3>{item.title}</h3><p>{item.detail}</p></div></article>)}</div>
    </div>
  </section>

  <section class="work-section section-pad" id="work">
    <div class="wrap">
      <div class="section-heading section-heading-wide">
        <p class="section-context">{lang === 'es' ? 'Trabajo en equipo' : 'Team delivery'}</p>
        <h2>{data.workTitle}</h2>
        <p>{data.workIntro}</p>
      </div>
      <div class="work-grid">{data.workAreas.map((area, index) => <article class={`work-area work-area-${index + 1}`}><span class="work-scope">{area.scope}</span><h3>{area.title}</h3><p>{area.examples}</p></article>)}</div>
    </div>
  </section>

  <section class="gallery-section section-pad" id="gallery">
    <div class="wrap">
      <div class="section-heading section-heading-wide">
        <p class="section-context">{lang === 'es' ? 'Capturas con datos ficticios' : 'Screens with fictional data'}</p>
        <h2>{data.galleryTitle}</h2>
        <p>{data.galleryIntro}</p>
      </div>
      <div class="gallery-grid">
        {data.screens.map((screen) => (
          <figure class="product-screen" id={`screen-${screen.key}`}>
            <div class="browser-frame">
              <div class="browser-bar" aria-hidden="true"><span></span><span></span><span></span><small>{lang === 'es' ? 'Vista de producto' : 'Product view'}</small></div>
              <img src={`${base}assets/screens/${screen.key}-desktop.webp`} width="1440" height="900" loading="lazy" alt={`${lang === 'es' ? 'Captura ficticia' : 'Fictional screenshot'}: ${screen.title}`} />
            </div>
            <figcaption><h3>{screen.title}</h3><p>{screen.description}</p><small>{screen.decision}</small></figcaption>
            <details class="mobile-capture">
              <summary><span class="material-symbols-outlined" aria-hidden="true">smartphone</span>{data.mobileLabel}</summary>
              <div class="device-frame"><img src={`${base}assets/screens/${screen.key}-mobile.webp`} width="390" height="844" loading="lazy" alt={`${lang === 'es' ? 'Captura móvil ficticia' : 'Fictional mobile screenshot'}: ${screen.title}`} /></div>
            </details>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="services-section section-pad">
    <div class="wrap services-layout">
      <div class="section-heading">
        <p class="section-context">{lang === 'es' ? 'Colaboración freelance' : 'Freelance collaboration'}</p>
        <h2>{data.servicesTitle}</h2>
        <p>{data.contactIntro}</p>
      </div>
      <ul class="services-list">{data.contactServices.map((service) => <li><span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span>{service}</li>)}</ul>
    </div>
  </section>

  <section class="contact-section">
    <div class="wrap contact-inner">
      <div><p class="contact-kicker">{lang === 'es' ? '¿Tienes un reto parecido?' : 'Working on a similar challenge?'}</p><h2>{data.contactTitle}</h2><p>{data.contactIntro}</p></div>
      <div class="contact-actions"><a class="button button-light" href={`mailto:${AUTHOR_EMAIL}`}>{data.contactCta}</a><a href={AUTHOR_URL}>{lang === 'es' ? 'Más sobre mi trabajo' : 'More about my work'} <span aria-hidden="true">↗</span></a><a class="docs-link" href={`${base}docs/`}>{data.docs}</a></div>
    </div>
  </section>
</main>

<footer class="site-footer wrap"><p>{data.footer}</p><a href={AUTHOR_URL}>fjbatresv.com</a></footer>

<script>
  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const setTheme = (theme: 'light' | 'dark') => {
    document.documentElement.dataset.theme = theme;
    if (themeButton) {
      themeButton.setAttribute('aria-pressed', String(theme === 'dark'));
      themeButton.querySelector('[data-theme-label]')!.textContent = theme === 'dark' ? themeButton.dataset.darkLabel! : themeButton.dataset.lightLabel!;
      themeButton.querySelector('.material-symbols-outlined')!.textContent = theme === 'dark' ? 'light_mode' : 'dark_mode';
    }
  };
  setTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
  themeButton?.addEventListener('click', () => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    localStorage.setItem('sar-theme', theme);
    setTheme(theme);
  });
</script>
