---
import type { Lang, LandingCopy } from '../../data/landing';

const { lang, data } = Astro.props as { lang: Lang; data: LandingCopy };
const es = lang === 'es';
---

<figure class="architecture-figure" aria-labelledby="architecture-caption">
  <div class="diagram-scroll" tabindex="0" role="region" aria-label={data.diagramTitle}>
    <svg viewBox="0 0 1200 640" role="img" aria-labelledby="diagram-title diagram-desc" xmlns="http://www.w3.org/2000/svg">
      <title id="diagram-title">{data.diagramTitle}</title>
      <desc id="diagram-desc">{data.diagramDescription}</desc>
      <defs>
        <marker id="sync-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path class="arrow-sync" d="M0 0L10 5 0 10z" /></marker>
        <marker id="async-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path class="arrow-async" d="M0 0L10 5 0 10z" /></marker>
      </defs>

      <text class="diagram-region" x="40" y="35">{es ? 'ENTREGA DE LA APLICACIÓN' : 'APPLICATION DELIVERY'}</text>
      <g class="diagram-node node-edge"><rect x="40" y="58" width="220" height="80" rx="14"/><text x="150" y="91">{es ? 'Equipo de tienda' : 'Store team'}</text><text class="node-sub" x="150" y="116">{es ? 'Navegador' : 'Browser'}</text></g>
      <g class="diagram-node node-edge"><rect x="370" y="58" width="220" height="80" rx="14"/><text x="480" y="91">CloudFront</text><text class="node-sub" x="480" y="116">{es ? 'Distribución web' : 'Edge delivery'}</text></g>
      <g class="diagram-node node-data"><rect x="700" y="58" width="260" height="80" rx="14"/><text x="830" y="91">S3 · Angular SPA</text><text class="node-sub" x="830" y="116">{es ? 'Archivos estáticos' : 'Static application files'}</text></g>
      <path class="edge edge-sync" d="M260 98H362" marker-end="url(#sync-arrow)"/><path class="edge edge-sync" d="M590 98H692" marker-end="url(#sync-arrow)"/>

      <text class="diagram-region" x="40" y="195">{es ? 'SOLICITUDES SÍNCRONAS' : 'SYNCHRONOUS REQUESTS'}</text>
      <g class="diagram-node node-edge"><rect x="40" y="218" width="190" height="86" rx="14"/><text x="135" y="251">{es ? 'Aplicación Angular' : 'Angular SPA'}</text><text class="node-sub" x="135" y="278">{es ? 'Interfaz de operación' : 'Store workflows'}</text></g>
      <g class="diagram-node node-identity"><rect x="275" y="218" width="200" height="86" rx="14"/><text x="375" y="251">API Gateway</text><text class="node-sub" x="375" y="278">{es ? 'Authorizer propio' : 'Custom authorizer'}</text></g>
      <g class="diagram-node node-compute"><rect x="520" y="218" width="190" height="86" rx="14"/><text x="615" y="251">VPC Link + ALB</text><text class="node-sub" x="615" y="278">{es ? 'Ruta privada' : 'Private route'}</text></g>
      <g class="diagram-node node-compute"><rect x="755" y="218" width="205" height="86" rx="14"/><text x="857" y="251">ECS Fargate</text><text class="node-sub" x="857" y="278">{es ? 'Servicios Java por dominio' : 'Java domain services'}</text></g>
      <g class="diagram-node node-data"><rect x="1000" y="218" width="160" height="86" rx="14"/><text x="1080" y="251">RDS MySQL</text><text class="node-sub" x="1080" y="278">{es ? 'Datos transaccionales' : 'Transactional data'}</text></g>
      <path class="edge edge-sync" d="M230 261H267" marker-end="url(#sync-arrow)"/><path class="edge edge-sync" d="M475 261H512" marker-end="url(#sync-arrow)"/><path class="edge edge-sync" d="M710 261H747" marker-end="url(#sync-arrow)"/><path class="edge edge-sync" d="M960 261H992" marker-end="url(#sync-arrow)"/>

      <g class="diagram-node node-identity"><rect x="275" y="340" width="200" height="72" rx="14"/><text x="375" y="370">Cognito</text><text class="node-sub" x="375" y="393">{es ? 'Identidad y MFA' : 'Identity and MFA'}</text></g>
      <path class="edge edge-sync" d="M375 304V332" marker-end="url(#sync-arrow)"/>
      <g class="diagram-node node-analytics"><rect x="755" y="340" width="205" height="72" rx="14"/><text x="857" y="370">Superset</text><text class="node-sub" x="857" y="393">{es ? 'Dashboards con RLS' : 'Embedded dashboards with RLS'}</text></g>
      <path class="edge edge-sync" d="M857 304V332" marker-end="url(#sync-arrow)"/>

      <text class="diagram-region" x="40" y="470">{es ? 'TRABAJO ASÍNCRONO' : 'ASYNCHRONOUS WORK'}</text>
      <g class="diagram-node node-event"><rect x="40" y="492" width="240" height="82" rx="14"/><text x="160" y="524">EventBridge + SQS</text><text class="node-sub" x="160" y="550">{es ? 'Eventos y tareas programadas' : 'Events and scheduled jobs'}</text></g>
      <g class="diagram-node node-compute"><rect x="365" y="492" width="240" height="82" rx="14"/><text x="485" y="524">{es ? 'Lambdas por dominio' : 'Domain Lambdas'}</text><text class="node-sub" x="485" y="550">Node.js · TypeScript</text></g>
      <path class="edge edge-async" d="M280 533H357" marker-end="url(#async-arrow)"/>
      <path class="edge edge-async" d="M485 574V608H1095"/><path class="edge edge-async" d="M720 608V582" marker-end="url(#async-arrow)"/><path class="edge edge-async" d="M920 608V582" marker-end="url(#async-arrow)"/><path class="edge edge-async" d="M1095 608V582" marker-end="url(#async-arrow)"/>
      <g class="diagram-node node-data"><rect x="635" y="492" width="170" height="82" rx="14"/><text x="720" y="524">DynamoDB</text><text class="node-sub" x="720" y="550">{es ? 'Datos de plataforma' : 'Platform data'}</text></g>
      <g class="diagram-node node-event"><rect x="850" y="492" width="140" height="82" rx="14"/><text x="920" y="524">SES</text><text class="node-sub" x="920" y="550">{es ? 'Correo' : 'Email'}</text></g>
      <g class="diagram-node node-data"><rect x="1030" y="492" width="130" height="82" rx="14"/><text x="1095" y="524">S3</text><text class="node-sub" x="1095" y="550">{es ? 'Textos y PDFs' : 'Translations and PDFs'}</text></g>

      <g class="diagram-legend" transform="translate(990 78)"><line class="edge edge-sync" x1="0" y1="0" x2="38" y2="0" marker-end="url(#sync-arrow)"/><text x="50" y="5">{es ? 'Síncrono' : 'Synchronous'}</text><line class="edge edge-async" x1="0" y1="24" x2="38" y2="24" marker-end="url(#async-arrow)"/><text x="50" y="29">{es ? 'Asíncrono' : 'Asynchronous'}</text></g>
    </svg>
  </div>
  <figcaption id="architecture-caption">{data.diagramTitle}</figcaption>
  <details class="architecture-list"><summary>{data.diagramListTitle}</summary><ol>{data.diagramList.map((item) => <li>{item}</li>)}</ol></details>
</figure>
