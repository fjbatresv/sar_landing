---
import { Font } from 'astro:assets';
import type { Lang } from '../data/landing';
import '../styles/global.css';

const { lang, title, description } = Astro.props as { lang: Lang; title: string; description: string };
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const site = Astro.site!;
const en = new URL(base, site).href;
const es = new URL(`${base}es/`, site).href;
const canonical = lang === 'es' ? es : en;
const og = new URL(`${base}assets/og-sar.png`, site).href;
const author = { '@type': 'Person', name: 'Javier Batres', url: 'https://fjbatresv.com' };
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'SAR architecture case study', url: en, inLanguage: ['en', 'es'], author },
    author,
    { '@type': 'CreativeWork', name: 'Restaurant operations platform', description, url: canonical, inLanguage: lang, author, image: og, about: ['restaurant operations', 'inventory management', 'cash reconciliation', 'event-driven services', 'AWS architecture'] },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={en} />
    <link rel="alternate" hreflang="es" href={es} />
    <link rel="alternate" hreflang="x-default" href={en} />
    <meta name="theme-color" content="#f7f7f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141633" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A restaurant operations platform from opening count to daily close" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content="Restaurant operations platform architecture" />
    <script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('sar-theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch{document.documentElement.dataset.theme='light'}</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    <Font cssVariable="--font-body" preload={[{ subset: 'latin', style: 'normal', weight: 400 }]} />
    <Font cssVariable="--font-display" preload={[{ subset: 'latin', style: 'normal', weight: 700 }]} />
    <Font cssVariable="--font-icons" />
  </head>
  <body><slot /></body>
</html>
